#include <FastLED.h>

// ======================================
// NEXUS SMART HOME
// Arduino UNO + WS2812B + Sensor PIR
// ======================================

// CONFIGURACAO DA FITA
#define NUM_LEDS 144
#define DATA_PIN 3

// SENSOR DE PRESENCA
#define SENSOR_PIR 2

// ARRAY DE LEDS
CRGB leds[NUM_LEDS];

// PALETA DE CORES
const CRGB cores[] = {
  CRGB::Blue,
  CRGB::Red,
  CRGB::Green,
  CRGB::Purple,
  CRGB::Cyan,
  CRGB::White,
  CRGB(255, 80, 150)

};

const int TOTAL_CORES = 7;

// TEMPOS
const unsigned long TEMPO_AUSENCIA = 60000;
const unsigned long INTERVALO_EFEITO = 10;
const unsigned long TEMPO_PAUSA = 500;

// CONTROLE DA ILUMINACAO
int brilho = 0;
int corAtual = 0;

bool iluminacaoLigada = false;

unsigned long ultimoMovimento = 0;
unsigned long ultimoEfeito = 0;
unsigned long inicioPausa = 0;

// ETAPAS DOS EFEITOS
enum EstadoEfeito {
  AUMENTANDO,
  DIMINUINDO,
  PAUSADO
};

EstadoEfeito estadoEfeito = AUMENTANDO;

// ======================================
// CONFIGURACAO INICIAL
// ======================================

void setup() {

  pinMode(SENSOR_PIR, INPUT);

  Serial.begin(9600);

  FastLED.addLeds<NEOPIXEL, DATA_PIN>(
    leds, NUM_LEDS
  );

  FastLED.setBrightness(0);
  FastLED.clear();
  FastLED.show();

  Serial.println("NEXUS SMART HOME");
  Serial.println("Inicializando sensor PIR...");

  delay(30000);

  Serial.println("Sistema pronto!");
  Serial.println("Aguardando presenca...");
}

// ======================================
// SELECAO DAS CORES
// ======================================

void selecionarCor() {

  fill_solid(
    leds,
    NUM_LEDS,
    cores[corAtual]
  );

}

// ======================================
// EFEITOS DE ILUMINACAO
// ======================================

void executarEfeito() {

  switch (estadoEfeito) {

    // AUMENTA A INTENSIDADE
    case AUMENTANDO:

      if (brilho < 255) {
        brilho++;
      }

      else {
        estadoEfeito = DIMINUINDO;
      }

      break;

    // DIMINUI A INTENSIDADE
    case DIMINUINDO:

      if (brilho > 0) {
        brilho--;
      }

      else {
        estadoEfeito = PAUSADO;
        inicioPausa = millis();
      }

      break;

    // PAUSA ENTRE AS CORES
    case PAUSADO:

      if (millis() - inicioPausa >= TEMPO_PAUSA) {

        corAtual++;

        if (corAtual >= TOTAL_CORES) {
          corAtual = 0;
        }

        selecionarCor();

        estadoEfeito = AUMENTANDO;
      }

      break;
  }

}

// ======================================
// LOOP PRINCIPAL
// ======================================

void loop() {

  unsigned long agora = millis();

  // LEITURA DO SENSOR PIR
  int presenca = digitalRead(SENSOR_PIR);

  // DETECCAO DE MOVIMENTO
  if (presenca == HIGH) {

    ultimoMovimento = agora;

    if (!iluminacaoLigada) {

      iluminacaoLigada = true;

      estadoEfeito = AUMENTANDO;

      selecionarCor();

      Serial.println("Presenca detectada!");
      Serial.println("Iluminacao ativada!");

    }

  }

  // VERIFICA TEMPO SEM MOVIMENTO
  if (iluminacaoLigada &&
      agora - ultimoMovimento >= TEMPO_AUSENCIA) {

    iluminacaoLigada = false;

    Serial.println("Ausencia detectada.");
    Serial.println("Desligando iluminacao...");

  }

  // EXECUCAO DOS EFEITOS
  if (agora - ultimoEfeito >= INTERVALO_EFEITO) {

    ultimoEfeito = agora;

    if (iluminacaoLigada) {

      executarEfeito();

    }

    else {

      // APAGA GRADUALMENTE
      if (brilho > 0) {
        brilho--;
      }

      else {
        FastLED.clear();
      }

    }

    // ATUALIZA A INTENSIDADE E A FITA
    FastLED.setBrightness(brilho);
    FastLED.show();

  }

}
